# ---- Database: Firebase Firestore ----
DB_BACKEND=firestore
# Path to the service-account key you download from Firebase (Project settings -> Service accounts -> Generate new private key)
FIREBASE_CREDENTIALS=firebase-service-account.json
# Optional - only needed if the key file does not contain the project id
FIREBASE_PROJECT_ID=

# ---- App ----
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
ADMIN_NAME=CareerLens Admin
ADMIN_EMAIL=admin@careerlens.com
ADMIN_PASSWORD=Admin@123
DEBUG=true
