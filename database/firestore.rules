rules_version = '2';
// CareerLens talks to Firestore only through its FastAPI backend (Firebase Admin SDK, which bypasses these rules).
// Deny every direct browser/mobile access so nobody can read or write data around the API.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
